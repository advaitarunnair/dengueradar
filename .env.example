# Copy to .env (gitignored) for local runs; set the same names in Vercel > Project > Settings > Environment Variables.

# Nebius Token Factory (NVIDIA Nemotron models). Server-side only, never exposed to the browser.
NEBIUS_API_KEY=

# Tavily web search, used by the planning agent for recent NEA / weather context.
TAVILY_API_KEY=

# Neon Postgres connection string. Injected automatically on Vercel by the Neon integration.
DATABASE_URL=

# Credit safety: total LLM tokens (prompt + completion) allowed per UTC day across all users.
DAILY_TOKEN_CAP=400000
# Per-session limits (LLM calls per hour).
SESSION_CALLS_PER_HOUR=40
SESSION_ULTRA_CALLS_PER_HOUR=6
